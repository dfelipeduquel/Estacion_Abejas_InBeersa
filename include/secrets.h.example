/**
 * @file secrets.h.example
 * @brief Plantilla de credenciales privadas para InBeersa.
 *
 * Copie este archivo como `include/secrets.h` y complete con sus credenciales reales.
 * El archivo `include/secrets.h` está excluido de Git mediante `.gitignore`.
 */

#ifndef SECRETS_H
#define SECRETS_H

// Red Wi-Fi local (Modo STA)
#define SECRET_WIFI_SSID       "TU_RED_WIFI"
#define SECRET_WIFI_PASS       "TU_CLAVE_WIFI"

// Punto de Acceso local de campo y mantenimiento (SoftAP)
#define SECRET_AP_SSID         "InBeersa-Abejas-192.168.4.1"
#define SECRET_AP_PASS         "CAMBIAR_CLAVE_AP"

// Telemetría MQTT en Ubidots Industrial
#define SECRET_UBIDOTS_TOKEN   "BBUS-TU_TOKEN_DE_UBIDOTS"
#define SECRET_UBIDOTS_DEVICE  "inbeersa-nodo01"

// Identificador de estación / colmena
#define SECRET_NOMBRE_COLMENA  "Colmena InBeersa 01"

#endif // SECRETS_H
